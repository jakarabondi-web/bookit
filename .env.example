# ---------------------------------------------------------------------------
# Bookit environment template. Copy to `.env.local` and fill in.
# Never commit real secrets — production values belong in a secrets manager.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data layer.
# Leave DATABASE_URL unset to run against the in-memory repositories seeded with
# demo data (zero-setup local development). Set it to point the Prisma
# repositories at PostgreSQL.
# DATABASE_URL=postgresql://bookit:bookit@localhost:5432/bookit?schema=public
# REDIS_URL=redis://localhost:6379

# Ticket credential signing. Keys are versioned so they can be rotated without
# invalidating credentials that are still in flight.
TICKET_CREDENTIAL_ACTIVE_KEY_ID=k1
TICKET_CREDENTIAL_KEYS=k1:dev-only-change-me-0123456789abcdef
TICKET_CREDENTIAL_TTL_SECONDS=45

# Session / auth
SESSION_SECRET=dev-only-change-me-session-secret
MAGIC_LINK_TTL_SECONDS=900

# Payments — Safaricom M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/v1/payments/webhooks/mpesa
MPESA_WEBHOOK_ALLOWLIST=196.201.214.0/24

# Card PSP (licensed acquirer)
CARD_PSP_PUBLIC_KEY=
CARD_PSP_SECRET_KEY=
CARD_PSP_WEBHOOK_SECRET=

# Notifications
SMTP_URL=
SMS_PROVIDER_API_KEY=

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=bookit-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
